# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# =============================================================================
# MODE CONFIGURATION
# =============================================================================
# Set to "production" when deploying with Docker, or "development" for local dev
SUPABASE_MULTITENANT_MODE="development"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL is required (both development and production)
# 
# For local development, use docker-compose.dev.yml to run PostgreSQL:
#   docker compose -f docker-compose.dev.yml up -d
#   Then use this connection string:
DATABASE_URL="postgresql://supabase_multitenant:supabase_multitenant_dev_password@localhost:5433/supabase_multitenant"

# For production (set by install.sh):
# DATABASE_URL="postgresql://supabase_multitenant:your_password@postgres:5432/supabase_multitenant"

# =============================================================================
# AUTHENTICATION (Auth.js v5 — see docs/adr/0001-authjs.md)
# =============================================================================
# Secret used to sign the session JWT. Required in production.
# Auth.js reads AUTH_SECRET; NEXTAUTH_SECRET and (in the Docker image)
# SERVICE_PASSWORD_NEXTAUTHSECRET are accepted as fallbacks.
AUTH_SECRET="your-secret-key-here-make-this-random-and-secure"
# Auth.js is always behind a reverse proxy in production; leave this on.
AUTH_TRUST_HOST=true
# Kept for backwards compatibility with older configs.
NEXTAUTH_SECRET="your-secret-key-here-make-this-random-and-secure"
NEXTAUTH_URL="http://localhost:3000"

# --- OAuth providers (optional) ---------------------------------------------
# GitHub is advertised only when BOTH values are set.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# =============================================================================
# SMTP CONFIGURATION (Optional)
# =============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
SUPABASE_CORE_REPO_URL="https://github.com/supabase/supabase"

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_NAME="Supabase Multitenant"
APP_URL="http://localhost:3000"

# =============================================================================
# TRAEFIK CONFIGURATION (Production only)
# =============================================================================
# Email for Let's Encrypt SSL certificates
TRAEFIK_ACME_EMAIL="admin@example.com"

# =============================================================================
# DATA PATHS (Production only - set by install.sh)
# =============================================================================
# DATA_PATH="/etc/supabase-multitenant"