// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (next-auth v5) models — see docs/adr/0001-authjs.md
// User.email/password are kept so the legacy bcryptjs credentials keep working;
// password is optional because OAuth-only accounts have none.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  image         String?
  name          String?
  password      String? // bcryptjs hash; null for OAuth-only users
  role          String    @default("member") // owner | admin | member
  disabled      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts    Account[]
  sessions    Session[]
  projects    Project[]
  teamMembers TeamMember[]
  passwordResetTokens PasswordResetToken[]
  organizations       Organization[]
  organizationMembers OrganizationMember[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Panel domain models
// ---------------------------------------------------------------------------

model Project {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  description    String?
  status         String   @default("active") // active, paused, stopped
  domain         String?  // Custom domain for API (Kong)
  domainVerified Boolean  @default(false) // Whether the API domain is verified
  studioDomain   String?  // Custom domain for Supabase Studio
  studioDomainVerified Boolean @default(false) // Whether the Studio domain is verified
  region         String?  // e.g. eu-central-1
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Owner
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Organization (nullable: existing projects are adopted by a default org)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Relations
  envVars     ProjectEnvVar[]
  backups     ProjectBackup[]

  @@map("projects")
}

// ---------------------------------------------------------------------------
// Project backups — the durability story and the restore/rollback primitive
// used both for disaster recovery and for the cloud -> self-hosted migration.
// ---------------------------------------------------------------------------

model ProjectBackup {
  id             String    @id @default(uuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind           String    @default("database") // database | storage
  status         String    @default("running")  // running | completed | failed
  fileName       String
  filePath       String
  sizeBytes      BigInt?
  sha256         String?
  error          String?
  restoreCount   Int       @default(0)
  lastRestoredAt DateTime?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([projectId, createdAt])
  @@map("project_backups")
}

// ---------------------------------------------------------------------------
// Organizations (Supabase-like grouping of projects + members)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("Free") // Free | Pro | Team
  type      String   @default("Personal") // Personal | Company | Educational | Agency
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  members  OrganizationMember[]
  projects Project[]
  customRoles CustomRole[]
  invitations Invitation[]

  @@map("organizations")
}

/**
 * A one-time password reset token.
 *
 * Same discipline as invitations: only the hash is stored, so a leaked database
 * cannot be replayed; single use; short-lived.
 */
model PasswordResetToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/**
 * An invitation to join an organization.
 *
 * The raw token is never stored — only its hash — so a database leak cannot be
 * replayed to gain access. The link is shown once, to the person creating it.
 */
model Invitation {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email         String
  role          String  @default("viewer")
  customRoleId  String?
  customRole    CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  // sha256 of the token; the token itself lives only in the invite link.
  tokenHash String @unique
  status    String @default("pending") // pending | accepted | revoked

  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  acceptedByUserId String?

  createdAt DateTime @default(now())

  @@index([organizationId, status])
  @@index([email])
  @@map("invitations")
}

/**
 * An administrator-defined role: a named bundle of permissions.
 *
 * A member with a custom role has exactly these permissions — the built-in role
 * is ignored (see resolveEffectivePermissions). That lets an admin express
 * "developer, but without secrets access", which additive bundles could not.
 */
model CustomRole {
  id          String   @id @default(uuid())
  name        String
  description String?
  permissions String[] // Permission catalog keys
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  members OrganizationMember[]
  invitations Invitation[]

  @@unique([organizationId, name])
  @@map("custom_roles")
}

model OrganizationMember {
  id        String   @id @default(uuid())
  role      String   @default("viewer") // viewer | developer | admin | owner | member (legacy)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // When set, this member's access is exactly the custom role's permissions.
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

/**
 * Who did what. Access-control changes in particular must be attributable.
 */
model AuditLog {
  id             String   @id @default(uuid())
  action         String   // e.g. member.invite, role.update, project.delete
  organizationId String?
  actorId        String?
  actorEmail     String?
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model ProjectEnvVar {
  id        String   @id @default(uuid())
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("project_env_vars")
}

model TeamMember {
  id        String   @id @default(uuid())
  userId    String
  role      String   @default("member") // owner, admin, member
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("team_members")
}

model PanelSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("panel_settings")
}
